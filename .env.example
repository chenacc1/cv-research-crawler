# Database
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# GitHub API (optional, increases rate limit from 60 to 5000 req/h)
GITHUB_TOKEN=

# Arxiv Crawler
CRAWLER_ARXIV_ENABLED=true
CRAWLER_ARXIV_INTERVAL_MINUTES=360
CRAWLER_ARXIV_DELAY_SECONDS=3.0

# GitHub Crawler
CRAWLER_GITHUB_ENABLED=true
CRAWLER_GITHUB_INTERVAL_MINUTES=120
CRAWLER_GITHUB_DELAY_SECONDS=2.0

# Reports
REPORT_OUTPUT_DIR=./reports
REPORT_DAILY_CRON="0 22 * * *"
REPORT_WEEKLY_CRON="0 10 * * 1"

# Logging
LOG_LEVEL=INFO

# LLM Summary (any OpenAI-compatible API, e.g. Ollama / DeepSeek / OpenAI)
LLM_API_BASE=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b
LLM_SUMMARY_ENABLED=true
LLM_SUMMARY_MAX_TOKENS=300

# Crawler keyword filter (comma-separated, case-insensitive, leave empty to disable)
CRAWLER_KEYWORDS=computer vision,deep learning,image,video,detection,segmentation,generation,3d,nerf,diffusion,transformer,multimodal

# CORS
API_CORS_ORIGINS=http://localhost:5173

# App
APP_VERSION=1.0.0
