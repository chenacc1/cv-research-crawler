# Database (SQLite for local dev, PostgreSQL for server)
# SQLite:
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# PostgreSQL (uncomment and set password):
# DATABASE_URL=postgresql+asyncpg://crawler:YOUR_PASSWORD@postgres:5432/cv_crawler

# GitHub personal access token (required for GitHub API, avoid rate limits)
GITHUB_TOKEN=

# Crawler settings
CRAWLER_ARXIV_ENABLED=true
CRAWLER_ARXIV_INTERVAL_MINUTES=360
CRAWLER_ARXIV_DELAY_SECONDS=3.0

CRAWLER_GITHUB_ENABLED=true
CRAWLER_GITHUB_INTERVAL_MINUTES=120
CRAWLER_GITHUB_DELAY_SECONDS=2.0

# Reports
REPORT_OUTPUT_DIR=./reports
REPORT_DAILY_CRON="0 22 * * *"
REPORT_WEEKLY_CRON="0 10 * * 1"

# Logging
LOG_LEVEL=INFO

# CORS (comma-separated, for dev)
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
